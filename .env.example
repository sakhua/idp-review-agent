# Sao chép thành .env rồi điền khoá thật. .env đã nằm trong .gitignore.
OPENAI_API_KEY=sk-...
# Đổi theo model bạn có quyền truy cập. Cần model hỗ trợ strict json_schema.
OPENAI_MODEL=gpt-5.6
# Tuỳ chọn: dùng endpoint tương thích OpenAI khác (Azure, vLLM, OpenRouter...)
# OPENAI_BASE_URL=https://api.openai.com/v1
